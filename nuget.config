<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- IngeniousXUnitGenerator.Core を NuGet に公開するまでの間、隣のリポジトリでビルドしたパッケージを使う -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="IngeniousXUnitGenerator-local" value="../IngeniousXUnitGenerator/artifacts/packages" />
  </packageSources>
</configuration>
