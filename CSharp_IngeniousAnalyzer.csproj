<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>Yuji Kanda</Authors>
    <Description>IDEの標準機能の枠を超え、プロジェクト固有の規約や高度なLINQ最適化まで強制・自動化するC#静的アナライザーです。コードの可読性とパフォーマンスを同時に底上げし、保守性の高い持続可能なコードベースを実現します。</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kanda-IngeniousDesign/CSharp_IngeniousAnalyzer</PackageProjectUrl>

    <RepositoryUrl>https://github.com/kanda-IngeniousDesign/CSharp_IngeniousAnalyzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Version>3.2.1</Version>

    <PackageReleaseNotes>
      - LINQ002 (ToListToArrayDelete): foreachループ本体が列挙元コレクション自体をRemove/Add等で変更している場合、.ToList()/.ToArray()を誤って不要と判定しFixで削除してしまう不具合を修正（削除すると列挙中の変更でInvalidOperationExceptionが発生する）
      - Fix LINQ002 (ToListToArrayDelete) incorrectly flagging and removing a .ToList()/.ToArray() call whose corresponding foreach loop body mutates the original source collection (e.g. via Remove/Add); removing it would cause a runtime InvalidOperationException from mutating a collection during enumeration
    </PackageReleaseNotes>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CSharp_IngeniousAnalyzer</PackageId>
    <AssemblyName>CSharp_IngeniousAnalyzer</AssemblyName>
    <RootNamespace>CSharp_IngeniousAnalyzer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- テストプロジェクトをこの下に配置しているため、既定のglobに巻き込まれないよう除外する -->
  <ItemGroup>
    <Compile Remove="CSharp_IngeniousAnalyzer.Tests/**/*.cs" />
    <None Remove="CSharp_IngeniousAnalyzer.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs/" 
          Visible="false" />

    <None Include="$(OutputPath)\ja\$(AssemblyName).resources.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs/ja/" 
          Visible="false" />
  </ItemGroup>

</Project>