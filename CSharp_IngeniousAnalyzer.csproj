<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>Yuji Kanda</Authors>
    <Description>IDEの標準機能の枠を超え、プロジェクト固有の規約や高度なLINQ最適化まで強制・自動化するC#静的アナライザーです。コードの可読性とパフォーマンスを同時に底上げし、保守性の高い持続可能なコードベースを実現します。</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kanda-IngeniousDesign/CSharp_IngeniousAnalyzer</PackageProjectUrl>

    <RepositoryUrl>https://github.com/kanda-IngeniousDesign/CSharp_IngeniousAnalyzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Version>3.4.1</Version>

    <PackageReleaseNotes>
      - LINQ002の誤検知を修正: ToList()/ToArray() の結果を変数に入れた後、foreach より前に列挙元を変更（Clear()/Add()/インデクサーでの書き換え等）している場合や、外側のループで次の周回より先に列挙元を変更している場合にも警告し、Fixで削除するとループが変更後の内容を回してしまっていた。確定後に列挙元を参照している場合は意図的なスナップショットとみなし、警告しないようにした
      - Fix a LINQ002 false positive: the rule warned even when the source collection was changed after ToList()/ToArray() was stored in a variable (for example with Clear(), Add(), or an indexer assignment before the foreach, or in an outer loop before the next iteration), and applying the Fix made the loop iterate over the changed contents. When the source is referenced after the materialization, the call is now treated as an intentional snapshot and no warning is reported
    </PackageReleaseNotes>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CSharp_IngeniousAnalyzer</PackageId>
    <AssemblyName>CSharp_IngeniousAnalyzer</AssemblyName>
    <RootNamespace>CSharp_IngeniousAnalyzer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
    <!-- "// Ignore" の判定・挿入など、XUnit_IngeniousGenerator と共有する部品（dll ではなくソースとして取り込む） -->
    <PackageReference Include="Roslyn_IngeniousCommon" Version="1.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Roslyn_IngeniousCommon" />
  </ItemGroup>

  <!-- テストプロジェクトをこの下に配置しているため、既定のglobに巻き込まれないよう除外する -->
  <ItemGroup>
    <Compile Remove="CSharp_IngeniousAnalyzer.Tests/**/*.cs" />
    <None Remove="CSharp_IngeniousAnalyzer.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs/" 
          Visible="false" />

    <None Include="$(OutputPath)\ja\$(AssemblyName).resources.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs/ja/" 
          Visible="false" />
  </ItemGroup>

</Project>