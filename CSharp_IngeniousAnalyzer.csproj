<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Version>1.7.6</Version>
    <PackageReleaseNotes>
      - 関数のセマンティック複雑度測定（CPX001）を追加しました。
      - Add semantic complexity measurement for functions (CPX001).
    </PackageReleaseNotes>    
    
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <Authors>Yuji Kanda</Authors>
    <Description>C#コードの品質を劇的に高める静的アナライザーです。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CSharp_IngeniousAnalyzer</PackageId>
    <AssemblyName>CSharp_IngeniousAnalyzer</AssemblyName>
    <RootNamespace>CSharp_IngeniousAnalyzer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

 <ItemGroup>
  <None Include="$(OutputPath)\$(AssemblyName).dll" 
        Pack="true" 
        PackagePath="analyzers/dotnet/cs/" 
        Visible="false" />

  <None Include="$(OutputPath)\ja\$(AssemblyName).resources.dll" 
        Pack="true" 
        PackagePath="analyzers/dotnet/cs/ja/" 
        Visible="false" />
  </ItemGroup>

</Project>