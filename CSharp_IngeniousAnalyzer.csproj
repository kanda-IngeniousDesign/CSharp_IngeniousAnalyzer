<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>Yuji Kanda</Authors>
    <Description>IDEの標準機能の枠を超え、プロジェクト固有の規約や高度なLINQ最適化まで強制・自動化するC#静的アナライザーです。コードの可読性とパフォーマンスを同時に底上げし、保守性の高い持続可能なコードベースを実現します。</Description>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kanda-IngeniousDesign/CSharp_IngeniousAnalyzer</PackageProjectUrl>

    <RepositoryUrl>https://github.com/kanda-IngeniousDesign/CSharp_IngeniousAnalyzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
    <Version>3.3.0</Version>

    <PackageReleaseNotes>
      - ASYNC001を追加: Task / Task&lt;T&gt; / ValueTask / ValueTask&lt;T&gt; を ConfigureAwait なしで await している箇所を検知（async void・static Main・トップレベルステートメント内は対象外）。await以降のコンテキスト依存を100%判定できないため ".ConfigureAwait(false)" を追記するFixは提供せず、"// Ignore ASYNC001" コメントを挿入するFixのみ提供
      - Add ASYNC001: detect awaiting Task / Task&lt;T&gt; / ValueTask / ValueTask&lt;T&gt; without ConfigureAwait, (async void, static Main, and top-level statements are excluded). Because whether the code after the await depends on the original context can't be determined with 100% accuracy, no Fix appends ".ConfigureAwait(false)"; only a Fix that inserts a "// Ignore ASYNC001" comment is provided
      - CPX001/CPX002のIgnore Quick Fix: メソッド本体の先頭ステートメント前に挿入する際、改行コードの判定に失敗して常にCRLFになり、LFのファイルで改行コードが混在する不具合を修正
      - Fix CPX001/CPX002 Ignore Quick Fix always inserting CRLF before the first statement of a method body (newline detection failed), which mixed line endings in LF files
    </PackageReleaseNotes>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CSharp_IngeniousAnalyzer</PackageId>
    <AssemblyName>CSharp_IngeniousAnalyzer</AssemblyName>
    <RootNamespace>CSharp_IngeniousAnalyzer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- テストプロジェクトをこの下に配置しているため、既定のglobに巻き込まれないよう除外する -->
  <ItemGroup>
    <Compile Remove="CSharp_IngeniousAnalyzer.Tests/**/*.cs" />
    <None Remove="CSharp_IngeniousAnalyzer.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs/" 
          Visible="false" />

    <None Include="$(OutputPath)\ja\$(AssemblyName).resources.dll" 
          Pack="true" 
          PackagePath="analyzers/dotnet/cs/ja/" 
          Visible="false" />
  </ItemGroup>

</Project>